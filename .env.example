# Copy to .env (gitignored) and fill in. Never commit .env.
# The build reads these; values are never echoed, logged, or committed.

# --- Model routing (blocker B2) -------------------------------------------
# One key backs every harness. Model IDs stay pinned exactly; never substituted.
OPENROUTER_API_KEY=

# --- Walkthrough narration (blocker B3) -----------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Application secrets (generated locally, never shared) -----------------
APP_SESSION_SECRET=
APP_CSRF_SECRET=
APP_JWT_SIGNING_KEY=
APP_ORIGINS=http://127.0.0.1:8080

# --- Service bindings ------------------------------------------------------
GATEWAY_BIND=127.0.0.1:8080
JAC_UPSTREAM=127.0.0.1:8000
NATS_URL=nats://127.0.0.1:4222
