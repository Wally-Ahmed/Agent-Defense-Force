# Copy to .env (gitignored) and fill in. Never commit .env.
# The build reads these; values are never echoed, logged, or committed.

# --- Model routing (blocker B2) -------------------------------------------
# One key backs every harness. Model IDs stay pinned exactly; never substituted.
OPENROUTER_API_KEY=

# --- Walkthrough narration (blocker B3) -----------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Application secrets (generated locally, never shared) -----------------
# HMAC key over the injected ReqCtx (contracts/req_ctx_contract.jac). The gateway
# and the app both REFUSE TO START without it — there is no default. Min 32 chars:
#   openssl rand -hex 32
APP_CTX_SIGNING_KEY=
APP_SESSION_SECRET=
APP_CSRF_SECRET=
APP_JWT_SIGNING_KEY=
APP_ORIGINS=http://127.0.0.1:8080

# Optional: redirect the append-only audit JSONL sink. Defaults to
# var/audit/audit.jsonl, which is what the monitor tails. Tests set this so they
# never write into the real trail.
# APP_AUDIT_LOG=var/audit/audit.jsonl

# --- Service bindings ------------------------------------------------------
GATEWAY_BIND=127.0.0.1:8080
JAC_UPSTREAM=127.0.0.1:8000
NATS_URL=nats://127.0.0.1:4222

# --- Cost guard -------------------------------------------------------------
# Warn (do not halt) when cumulative model spend crosses this. Set by user.
COST_WARN_USD=50
